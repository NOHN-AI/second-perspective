        "implementation_cost": 0.5,
        "four_laws_satisfied": true,
        "has_chain_and_verifier": true,
        "clock_injection_supported": true,
        "per_item_output": true,
        "testset_size_500": false
      },
      "required_assumptions": ["A2", "A3", "A4"],
      "evidence_ids": ["E2", "E3", "E4"]
    },
    {
      "id": "S3",
      "name": "No adoption - retain existing IMDA 95 framework",
      "description": "Continue using the existing IMDA AI Verify 95/100 assessment framework; do not adopt the new specification.",
      "metrics": {
        "dimension_coverage": 0.3,
